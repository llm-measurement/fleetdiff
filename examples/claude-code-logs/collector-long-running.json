{
  "receivers": {
    "otlp": {
      "protocols": {
        "http": {
          "endpoint": "127.0.0.1:4318"
        }
      }
    }
  },
  "exporters": {
    "file/capture": {
      "path": "${env:CLAUDE_CAPTURE_DIR}/logs.jsonl",
      "format": "json",
      "append": false,
      "create_directory": false,
      "rotation": {
        "max_megabytes": 8,
        "max_days": 15,
        "max_backups": 15,
        "localtime": false
      }
    }
  }
}
